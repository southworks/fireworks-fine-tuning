# Copy to .env and fill in (KEY=value, no quotes). .env is git-ignored and never printed.
# make results needs nothing from this file.

# --- Fireworks AI ---------------------------------------------------------------
# Used by firectl (or run `firectl signin`) and by the benchmark for inference.
FIREWORKS_API_KEY=
FW_ACCOUNT=southworks

# --- Microsoft Foundry ------------------------------------------------------------
# Resource that already has a GPT-5 deployment (baseline) and a GPT-6 Sol deployment (judge).
# Base URL: https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=
# Deployment names of those two models in your Foundry resource (required), e.g. gpt-5 and gpt-6-sol
FOUNDRY_GPT5_DEPLOYMENT=gpt-5
FOUNDRY_GPT6_SOL_DEPLOYMENT=gpt-6-sol
