# Copy to .env and fill in (KEY=value, no quotes). .env is git-ignored and never printed.
# Mode 1 (make results) needs nothing from this file.

# --- Fireworks AI ---------------------------------------------------------------
# Used by firectl (or run `firectl signin`) and by the benchmark for inference.
FIREWORKS_API_KEY=
FW_ACCOUNT=southworks

# --- Microsoft Foundry: where make deploy-foundry-models creates deployments (az login) ---
AZ_RESOURCE_GROUP=
AZ_FOUNDRY_ACCOUNT=

# --- Microsoft Foundry: inference (make deploy-foundry-models prints the URL) ---------
FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=
